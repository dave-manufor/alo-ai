{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "plan.schema.json",
  "title": "Plan",
  "description": "Firestore plans/{plan_id}: the two-week home plan (PRD 3.1, SDD 8 and 12). Producer: Reading Coach (W3). Consumer: the report screen (W1). Activities come only from the activity library, named by its version; guardian_id is what the Firestore rules check. summary_audio_uri is the spoken parent summary, null until it is made. template_used is true when the Coach was off or its summary failed the guardrail twice (COACH_TEMPLATE_USED).",
  "type": "object",
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "plan_id": { "type": "string", "minLength": 1 },
    "session_id": { "type": "string", "minLength": 1 },
    "child_id": { "type": "string", "minLength": 1 },
    "guardian_id": { "type": "string", "minLength": 1 },
    "activities": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "properties": {
          "activity_id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "text": { "type": "string", "minLength": 1 }
        },
        "required": ["activity_id", "title", "text"],
        "additionalProperties": false
      }
    },
    "book_ids": { "type": "array", "items": { "type": "string" }, "maxItems": 3 },
    "next_session_at": { "type": "string", "format": "date-time" },
    "summary_audio_uri": { "type": ["string", "null"], "pattern": "^gs://" },
    "template_used": { "type": "boolean" },
    "activity_library": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "required": ["schema_version", "plan_id", "session_id", "child_id", "guardian_id", "activities", "book_ids", "next_session_at", "summary_audio_uri", "template_used", "activity_library", "created_at"],
  "additionalProperties": false
}
