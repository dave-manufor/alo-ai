{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "phase1_telemetry.schema.json",
  "title": "Phase1Telemetry",
  "description": "Firestore sessions/{session_id}/phase1/telemetry (PRD 10.2). Producer: Reading Scorer (W3). Consumer: Grader (W3). A word is labelled only where the Chirp 3 and Gemini transcripts agree; otherwise it is UNCERTAIN and left out of every count. Accuracy and WCPM are null when no word could be scored. Every number comes from aloai_scoring, whose version is in model_versions.",
  "type": "object",
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "session_id": { "type": "string", "minLength": 1 },
    "passage_id": { "type": "string", "minLength": 1 },
    "passage_source": { "type": "string", "enum": ["BANK", "GENERATED"] },
    "reading_seconds": { "type": "number", "minimum": 0, "maximum": 90 },
    "words_attempted": { "type": "integer", "minimum": 0 },
    "words_correct": { "type": "integer", "minimum": 0 },
    "error_counts": {
      "type": "object",
      "properties": {
        "substitution": { "type": "integer", "minimum": 0 },
        "omission": { "type": "integer", "minimum": 0 },
        "told": { "type": "integer", "minimum": 0 },
        "mispronunciation": { "type": "integer", "minimum": 0 }
      },
      "required": ["substitution", "omission", "told", "mispronunciation"],
      "additionalProperties": false
    },
    "self_correction_count": { "type": "integer", "minimum": 0 },
    "uncertain_count": { "type": "integer", "minimum": 0 },
    "accuracy_pct": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
    "wcpm": { "type": ["number", "null"], "minimum": 0 },
    "self_correction_ratio": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "prosody": {
      "type": "object",
      "properties": {
        "reported": { "type": "boolean" },
        "pause_intrusion_rate": { "type": ["number", "null"], "minimum": 0 },
        "f0_word_corr": { "type": ["number", "null"], "minimum": -1, "maximum": 1 },
        "phrasing": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "expression": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "overall": { "type": ["number", "null"], "minimum": 0, "maximum": 100 }
      },
      "required": ["reported"],
      "additionalProperties": false
    },
    "word_events": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "token_index": { "type": "integer", "minimum": 0 },
          "target_word": { "type": "string" },
          "chirp_hypothesis": { "type": ["string", "null"] },
          "gemini_hypothesis": { "type": ["string", "null"] },
          "chirp_confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
          "start_ms": { "type": ["integer", "null"], "minimum": 0 },
          "end_ms": { "type": ["integer", "null"], "minimum": 0 },
          "label": { "type": "string", "enum": ["CORRECT", "DIALECT_VARIANT", "SUBSTITUTION", "OMISSION", "TOLD", "MISPRONUNCIATION", "UNCERTAIN"] },
          "is_self_corrected": { "type": "boolean" },
          "pre_word_latency_ms": { "type": ["integer", "null"], "minimum": 0 }
        },
        "required": ["token_index", "target_word", "label", "is_self_corrected"],
        "additionalProperties": false
      }
    },
    "flags": {
      "type": "array",
      "items": { "type": "string", "enum": ["SHORT_READING", "HIGH_UNCERTAINTY"] },
      "uniqueItems": true
    },
    "model_versions": {
      "type": "object",
      "properties": { "scoring_module": { "type": "string", "minLength": 1 } },
      "required": ["scoring_module"],
      "additionalProperties": { "type": "string" }
    }
  },
  "required": ["schema_version", "session_id", "passage_id", "passage_source", "reading_seconds", "words_attempted", "words_correct", "error_counts", "self_correction_count", "uncertain_count", "accuracy_pct", "wcpm", "self_correction_ratio", "prosody", "word_events", "flags", "model_versions"],
  "additionalProperties": false
}
